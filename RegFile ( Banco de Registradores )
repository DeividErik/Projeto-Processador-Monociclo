 * SEMESTRE LETIVO: 2026-1
 * QUESTÃO: Implementação do Banco de Registradores (Regfile)
 * DESCRIÇÃO: Contém 32 registradores de 32 bits. O registrador $0 é constante (0).
 * Possui duas leituras assíncronas e uma escrita síncrona na borda do clock.
 */

module regfile (
    input wire Clock,
    input wire Reset,
    input wire RegWrite,
    input wire [4:0] ReadAddr1,
    input wire [4:0] ReadAddr2,
    input wire [4:0] WriteAddr,
    input wire [31:0] WriteData,
    output wire [31:0] ReadData1,
    output wire [31:0] ReadData2
);

    // Array de 32 registradores de 32 bits
    reg [31:0] registers [31:0];
    integer i;

    // Leitura assíncrona: se o endereço for 0, retorna 0, senão retorna o valor armazenado
    assign ReadData1 = (ReadAddr1 == 5'b0) ? 32'b0 : registers[ReadAddr1];
    assign ReadData2 = (ReadAddr2 == 5'b0) ? 32'b0 : registers[ReadAddr2];

    // Escrita síncrona e lógica de reset
    always @(posedge Clock or posedge Reset) begin
        if (Reset) begin
            // Reseta todos os registradores para 0
            for (i = 0; i < 32; i = i + 1) begin
                registers[i] <= 32'b0;
            end
        end else if (RegWrite && WriteAddr != 5'b0) begin
            // Escreve o dado no registrador destino (protegendo o $0)
            registers[WriteAddr] <= WriteData;
        end
    end

endmodule
