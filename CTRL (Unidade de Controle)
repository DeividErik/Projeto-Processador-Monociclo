 * QUESTÃO: Implementação da Unidade de Controle (ctrl)
 * DESCRIÇÃO: Gera os sinais de controle principais baseados no opcode da instrução.
 * Adicionados os sinais Jump e BranchBne conforme necessidade do projeto.
 */

module ctrl (
    input wire [5:0] Opcode,
    output reg RegDst,
    output reg ALUSrc,
    output reg MemtoReg,
    output reg RegWrite,
    output reg MemRead,
    output reg MemWrite,
    output reg Branch,
    output reg BranchBne, // Sinal extra para o BNE
    output reg Jump,      // Sinal extra para as instruções tipo J
    output reg [2:0] ALUOp // 3 bits para acomodar todas as operações I-Type
);

    always @(*) begin
        // Valores padrão (zerados) para evitar latches indesejados
        RegDst    = 1'b0;
        ALUSrc    = 1'b0;
        MemtoReg  = 1'b0;
        RegWrite  = 1'b0;
        MemRead   = 1'b0;
        MemWrite  = 1'b0;
        Branch    = 1'b0;
        BranchBne = 1'b0;
        Jump      = 1'b0;
        ALUOp     = 3'b000;

        case (Opcode)
            6'b000000: begin // R-Type (add, sub, and, etc.)
                RegDst   = 1'b1;
                RegWrite = 1'b1;
                ALUOp    = 3'b010; // Código para a ula_ctrl olhar o Funct
            end
            
            6'b100011: begin // lw (Load Word)
                ALUSrc   = 1'b1;
                MemtoReg = 1'b1;
                RegWrite = 1'b1;
                MemRead  = 1'b1;
                ALUOp    = 3'b000; // ULA deve somar (Endereço-base + offset)
            end
            
            6'b101011: begin // sw (Store Word)
                ALUSrc   = 1'b1;
                MemWrite = 1'b1;
                ALUOp    = 3'b000; // ULA deve somar (Endereço-base + offset)
            end
            
            6'b000100: begin // beq (Branch on Equal)
                Branch   = 1'b1;
                ALUOp    = 3'b001; // ULA deve subtrair para comparar
            end

            6'b000101: begin // bne (Branch on Not Equal)
                BranchBne= 1'b1;
                ALUOp    = 3'b001; // ULA deve subtrair para comparar
            end
            
            6'b001000: begin // addi (Add Immediate)
                ALUSrc   = 1'b1;
                RegWrite = 1'b1;
                ALUOp    = 3'b000; // Força a soma
            end

            6'b000010: begin // j (Jump)
                Jump     = 1'b1;
            end
            
            
            default: ; // Mantém os valores padrão
        endcase
    end

endmodule
