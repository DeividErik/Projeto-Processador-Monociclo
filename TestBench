 * DISCIPLINA: Arquitetura e Organização de Computadores
 * SEMESTRE LETIVO: 2026-1
 * QUESTÃO: Testbench do MIPS
 * DESCRIÇÃO: Gera o sinal de clock, aplica o reset inicial e 
 * inicia a simulação do processador, gravando os dados para o gráfico (EPWave).
 */

// Define a escala de tempo da simulação
`timescale 1ns / 1ps

module tb_mips;

    // Entradas do processador (sinais que serão controlados no teste)
    reg clock;
    reg reset;

    // Saídas do processador (sinais de observação)
    wire [31:0] pc_out;
    wire [31:0] alu_out;
    wire [31:0] d_mem_out;

    // Instancia o módulo Top-Level (o MIPS completo)
    mips mips_inst (
        .clock(clock),
        .reset(reset),
        .current_pc_out(pc_out),
        .alu_result_out(alu_out),
        .d_mem_out(d_mem_out)
    );

    // Geração do Clock: inverte o sinal a cada 5 nanosegundos (período de 10ns)
    always #5 clock = ~clock;

    // Bloco inicial
    initial begin
        // Comandos obrigatórios do EDA Playground para gerar o gráfico
        $dumpfile("dump.vcd");
        $dumpvars(0, tb_mips);

        // Estado inicial
        clock = 0;
        reset = 1; // Mantém o processador em reset para limpar os registradores

        // Espera 10ns e solta o reset (inicio da operação do processador)
        #10 reset = 0;

        // Deixa a simulação rodar por mais 100ns (aproximadamente 10 instruções)
        #100;

        // Encerra a simulação
        $finish;
    end


endmodule
